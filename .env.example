# ═══════════════════════════════════════════════════════════════════════════════
# AI Fitness Trainer — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and customise for your deployment.
# All variables have safe defaults — you only need to set what you want to change.
#
# Usage:
#   cp .env.example .env
#   # Edit .env
#   export $(cat .env | xargs)   # or use python-dotenv / Docker --env-file
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Logging ───────────────────────────────────────────────────────────────────

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────────────────────

# Bind address and port for the FastAPI server
HOST=0.0.0.0
PORT=8000

# Must stay at 1 — the async inference queue is in-process and cannot be
# shared across uvicorn workers. For horizontal scaling, run multiple
# processes behind nginx / a load balancer.
WORKERS=1

# Comma-separated CORS allowed origins. Use * to allow all (default).
# Example: CORS_ORIGINS=https://app.mysite.com,https://staging.mysite.com
CORS_ORIGINS=*

# ── Model paths ───────────────────────────────────────────────────────────────

# YOLOv8 model variant: yolov8n.pt (fastest) | yolov8s.pt | yolov8m.pt
YOLO_MODEL=yolov8n.pt

# Legacy ST-GCN/BiLSTM checkpoint path. Kept for older scripts; the current
# server uses DL_CHECKPOINT_DIR below.
MODEL_CHECKPOINT=model/checkpoints/best.pth

# Legacy keypoint normalisation stats path. Kept for older scripts.
NORMALIZER_STATS=data/processed/normalizer_stats.json

# Current DLEngine per-exercise checkpoints:
#   checkpoints_v3/dl_model_squat.pt
#   checkpoints_v3/dl_model_pushup.pt
#   ...
DL_CHECKPOINT_DIR=checkpoints_v3

# DLEngine mode-vote smoother window in frames.
DL_SMOOTH_WINDOW=5

# Rep peak-gating override: auto | on | off
DL_REQUIRE_CLOSED=auto

# ── Voice coach ───────────────────────────────────────────────────────────────

# Include pre-exercise coach instructions in API responses.
VOICE_ENABLED=true

# auto uses OpenAI when OPENAI_API_KEY is set, otherwise Windows Speech fallback.
# openai forces OpenAI TTS, windows_sapi forces local Windows TTS,
# none returns text-only instructions.
VOICE_PROVIDER=auto

# Natural English coach language.
VOICE_LANGUAGE=en-US

# Generated audio cache. This directory is gitignored.
VOICE_CACHE_DIR=voice_cache

# Recommended OpenAI TTS model for concise, natural coach instructions.
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=verse
VOICE_TTS_FORMAT=mp3
VOICE_TTS_SPEED=1.0

# Optional. Quote this value if you enable it in a shell .env file.
# VOICE_TTS_STYLE="Natural English fitness coach: calm, clear, concise, and encouraging."

# Required only when VOICE_PROVIDER=openai and you want audio files generated.
# OPENAI_API_KEY=sk-...

# ── Inference backend selection ───────────────────────────────────────────────
#
# auto     — Try TRT, then ONNX, then PyTorch (recommended for production)
# trt      — Force TensorRT FP16 (requires .engine file + tensorrt + pycuda)
# onnx     — Force ONNX Runtime  (requires .onnx file + onnxruntime-gpu)
# pytorch  — Force PyTorch eager  (always available, slowest)
# mmpose   — Force MMPose         (pose only, always available)

DETECTOR_BACKEND=auto
POSE_BACKEND=auto

# Paths to pre-built TRT engine files (produced by tools/export_yolo_onnx.py)
TRT_ENGINE_PATH=models/yolo.engine
TRT_POSE_PATH=models/rtmpose.engine

# Paths to ONNX model files (produced by tools/export_yolo_onnx.py --no-trt)
ONNX_MODEL_PATH=models/yolo.onnx
ONNX_POSE_PATH=models/rtmpose.onnx

# ── Detection & tracking ──────────────────────────────────────────────────────

# YOLOv8 confidence threshold (0–1). Lower → more detections but more false positives.
DET_CONF=0.45

# YOLOv8 NMS IoU threshold (0–1)
DET_IOU=0.45

# YOLOv8 inference image size (square). Must be: 320 | 416 | 512 | 640 | 1280
DET_INPUT_SIZE=640

# Run YOLO every N frames; tracker coasts in between (hybrid pipeline).
# Higher = faster but tracker must handle more frames without re-detection.
# Recommended range: 2–5
DETECTION_INTERVAL=3

# IoU threshold for tracker to consider a detection as the same person
TRACKER_IOU_THRESHOLD=0.35

# Frames without a matching detection before tracker enters recovery mode
TRACKER_MAX_LOST=10

# ── Pose estimation ───────────────────────────────────────────────────────────

# Minimum keypoint confidence to accept (0–1). Below this → keypoint zeroed out.
POSE_SCORE_THRESHOLD=0.30

# ── Legacy temporal-model settings ────────────────────────────────────────────

# Sequence length for older ST-GCN/BiLSTM experiments
MODEL_WINDOW=32

# Legacy learned form-score threshold
FORM_THRESHOLD=0.60

# Legacy exercise classification confidence threshold
MODEL_CONF_THRESHOLD=0.50

# Legacy keypoint confidence threshold during model normalisation
MODEL_KP_CONF_THRESHOLD=0.25

# ── Async inference queue ─────────────────────────────────────────────────────

# Max frames queued per WebSocket session before backpressure fires
# Lower = tighter backpressure, higher = more buffering
QUEUE_MAX_PER_SESSION=4

# Max frames dispatched per GPU batch pass
QUEUE_BATCH_SIZE=8

# Number of inference threads in the ThreadPoolExecutor
# Rough guide: 2 for 1–4 users, 4 for 5–16 users, 8 for 16–64 users
QUEUE_INFERENCE_THREADS=4

# Dispatcher poll interval in seconds (lower = lower latency, higher CPU)
QUEUE_DISPATCH_INTERVAL=0.005

# ── Session management ────────────────────────────────────────────────────────

# Seconds of inactivity before a WebSocket session is expired and cleaned up
SESSION_TIMEOUT_SECS=300

# ── Desktop app (main.py only) ────────────────────────────────────────────────

# Video source: camera index (0, 1, ...) or path to a video file
VIDEO_SOURCE=0

# Show tracker debug overlay (bounding box, track ID, IoU, stability)
SHOW_TRACKING=false

# Run headless without cv2.imshow (useful for servers / CI)
NO_DISPLAY=false

# If set, save annotated video output to this path
# SAVE_VIDEO=output.mp4
